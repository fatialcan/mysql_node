<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Agregar usuario</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <style>
    body { background-color: #f5f6fa; }
    .sidebar { background-color: #0a1f44; min-height: 100vh; width: 220px; }
    .sidebar a {
      color: #c6ccdb; text-decoration: none; padding: 10px 20px;
      display: flex; align-items: center; gap: 10px;
    }
    .sidebar a.active, .sidebar a:hover { background-color: #16336e; color: #fff; }
  </style>
</head>
<body>
  <div class="d-flex">
    <div class="sidebar py-3">
      <div class="px-3 mb-4 text-white fw-bold fs-5"><i class="bi bi-hexagon-fill"></i> MiApp</div>
      <a href="/"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
      <a href="#"><i class="bi bi-pencil-square"></i> Form</a>
      <a href="#"><i class="bi bi-list-ul"></i> List</a>
      <a href="/usuarios" class="active"><i class="bi bi-people-fill"></i> Usuarios</a>
      <a href="#"><i class="bi bi-exclamation-triangle"></i> Excepciones</a>
      <a href="/logout"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a>
    </div>

    <div class="flex-grow-1">
      <nav class="navbar navbar-light bg-white border-bottom px-4 py-2">
        <span class="navbar-text fw-semibold">Agregar usuario</span>
        <span><%= nombre %></span>
      </nav>

      <div class="container p-4" style="max-width: 500px;">
        <div class="card shadow-sm p-4">
          <form action="/usuarios/agregar" method="POST">
            <div class="mb-3">
              <label class="form-label">Nombre</label>
              <input type="text" name="name" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" name="email" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Contraseña</label>
              <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-success w-100">Agregar</button>
            <a href="/usuarios" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
