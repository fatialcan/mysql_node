<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Inicio</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <style>
    body { background-color: #f5f6fa; }
    .sidebar {
      background-color: #0a1f44;
      min-height: 100vh;
      width: 220px;
    }
    .sidebar a {
      color: #c6ccdb;
      text-decoration: none;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .sidebar a.active, .sidebar a:hover {
      background-color: #16336e;
      color: #fff;
    }
    .card-stat { border: none; border-radius: 12px; }
    .avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: #0a1f44; color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar py-3">
      <div class="px-3 mb-4 text-white fw-bold fs-5">
        <i class="bi bi-hexagon-fill"></i> MiApp
      </div>
      <a href="/" class="active"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
      <a href="#"><i class="bi bi-pencil-square"></i> Form</a>
      <a href="#"><i class="bi bi-list-ul"></i> List</a>
      <a href="#"><i class="bi bi-person-lines-fill"></i> Perfil</a>
      <a href="/usuarios"><i class="bi bi-people-fill"></i> Usuarios</a>
      <a href="#" class="active"><i class="bi bi-check-circle-fill"></i> Resultado</a>
      <a href="#"><i class="bi bi-exclamation-triangle"></i> Excepciones</a>
      <a href="/logout"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a>
    </div>

    <!-- Contenido -->
    <div class="flex-grow-1">
      <!-- Navbar superior -->
      <nav class="navbar navbar-light bg-white border-bottom px-4 py-2">
        <span class="navbar-text fw-semibold">Panel principal</span>
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-search"></i>
          <i class="bi bi-question-circle"></i>
          <i class="bi bi-bell"></i>
          <div class="avatar"><%= typeof nombre !== 'undefined' ? nombre.charAt(0).toUpperCase() : 'U' %></div>
          <span><%= typeof nombre !== 'undefined' ? nombre : 'Usuario' %></span>
        </div>
      </nav>

      <div class="container-fluid p-4">
        <!-- Tarjetas de estadísticas -->
        <div class="row g-3 mb-4">
          <div class="col-md-3">
            <div class="card card-stat shadow-sm p-3">
              <div class="text-muted small">Total ventas</div>
              <div class="fs-3 fw-bold">$154,430</div>
              <div class="small text-success">▲ 13% esta semana</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card card-stat shadow-sm p-3">
              <div class="text-muted small">Visitas</div>
              <div class="fs-3 fw-bold">6,480</div>
              <div class="small text-muted">4,280 hoy</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card card-stat shadow-sm p-3">
              <div class="text-muted small">Pagos</div>
              <div class="fs-3 fw-bold">5,320</div>
              <div class="small text-muted">Conversión 50%</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card card-stat shadow-sm p-3">
              <div class="text-muted small">Efecto operación</div>
              <div class="fs-3 fw-bold">88%</div>
            </div>
          </div>
        </div>

        <!-- Gráfica -->
        <div class="card shadow-sm p-4">
          <h5 class="mb-3">Tendencia de ventas</h5>
          <canvas id="graficaVentas" height="90"></canvas>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <script>
    const ctx = document.getElementById('graficaVentas');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['2020', '2021', '2022', '2023', '2024', '2025'],
        datasets: [{
          label: 'Ventas',
          data: [45, 37, 33, 56, 39, 41],
          backgroundColor: '#4285f4'
        }]
      },
      options: {
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true } }
      }
    });
  </script>
</body>
</html>
